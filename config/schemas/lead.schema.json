{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Client Reach Lead",
  "type": "object",
  "required": ["lead_id", "organization", "source_evidence", "stage"],
  "properties": {
    "lead_id": {"type": "string"},
    "organization": {
      "type": "object",
      "required": ["legal_name"],
      "properties": {
        "legal_name": {"type": "string"},
        "registration_id": {"type": ["string", "null"]},
        "business_scope": {"type": ["string", "null"]},
        "business_scope_tags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "contact_candidates": {"type": "array", "items": {"type": "object"}},
    "product_recommendations": {"type": "array", "items": {"type": "object"}},
    "source_evidence": {"type": "array", "items": {"type": "object"}},
    "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "score_version": {"type": ["string", "null"]},
    "stage": {"enum": ["new", "review", "qualified", "nurture", "invalid", "converted"]},
    "next_action_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
